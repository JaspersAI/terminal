{
  "name": "prism-db",
  "version": "0.2.0",
  "description": "Embedded retrieval database for Node.js and Electron: exact hybrid (vector + BM25 + recency) search with typed filters, in one crash-safe file.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "jaspers-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./embed": {
      "jaspers-source": "./src/embed.ts",
      "types": "./src/embed.ts",
      "default": "./src/embed.ts"
    },
    "./ingest": {
      "jaspers-source": "./src/ingest.ts",
      "types": "./src/ingest.ts",
      "default": "./src/ingest.ts"
    },
    "./electron": {
      "jaspers-source": "./src/electron.ts",
      "types": "./src/electron.ts",
      "default": "./src/electron.ts"
    },
    "./electron-preload": {
      "jaspers-source": "./src/electron-preload.ts",
      "types": "./src/electron-preload.ts",
      "default": "./src/electron-preload.ts"
    },
    "./package.json": "./package.json"
  }
}
