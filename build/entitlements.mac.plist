<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime allows the app and every helper, and nothing more. -->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript to machine code as it runs. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Voice. Without it the hardened runtime refuses the microphone and macOS never asks. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
